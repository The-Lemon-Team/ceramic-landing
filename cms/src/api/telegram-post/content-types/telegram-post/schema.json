{
  "kind": "collectionType",
  "collectionName": "telegram_posts",
  "info": {
    "displayName": "Telegram Post",
    "singularName": "telegram-post",
    "pluralName": "telegram-posts",
    "description": "Посты из Telegram"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "category": {
      "type": "enumeration",
      "enum": ["Update", "Workshop", "Process", "Announcement"],
      "required": true
    },
    "image": {
      "type": "string",
      "description": "Путь к изображению (опционально)"
    },
    "text": {
      "type": "text",
      "required": true
    },
    "timestamp": {
      "type": "string",
      "required": true
    },
    "telegramUrl": {
      "type": "string",
      "description": "Ссылка на пост в Telegram"
    }
  }
}
