generator client {
  provider = "prisma-client-js"
}

generator nextAdmin {
  provider = "next-admin-generator-prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum TelegramPostCategory {
  Update
  Workshop
  Process
  Announcement
}

enum ArtsThemeMediaType {
  image
  video
}

model AdminUser {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  email        String   @unique
  passwordHash String
  name         String?
  isActive     Boolean  @default(true)
}

model Product {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  title          String
  slug           String   @unique
  priceKopeks       Int
  originalPriceKopeks Int?
  discountPercent Int?

  sortOrder      Int      @default(0)

  description    String
  category       String   @default("ГАЛЕРЕЯ")
  finish         String   @default("—")
  dimensions     String   @default("—")

  mainImage      String?
  thumbnail      String?

  images         ProductImage[]

  @@index([category])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  sortOrder Int     @default(0)
  url       String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model TelegramPost {
  id         String               @id @default(cuid())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  category   TelegramPostCategory
  image      String?
  text       String
  timestamp  String
  telegramUrl String?

  @@index([category])
}

model NavItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  href      String
  label     String
  sortOrder Int      @default(0)

  @@index([sortOrder])
}

model SiteConfig {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  singletonKey String   @unique @default("site-config")

  siteName     String
  heroSubTitle String
  heroMotto    String
  heroCtaHref  String
  heroCtaLabel String
}

model AboutAuthor {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  singletonKey String   @unique @default("about-author")

  sectionTitle String   @default("Об авторе")
  sectionLabel String   @default("Мастер")
  authorName   String
  bio          String
  photo        String?
  photoAlt     String?
  quote        String?
  closingText  String?
  signature    String?
}

model Directions {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  singletonKey String   @unique @default("directions")

  title        String   @default("Как добраться")
  address      String?
  mapUrl       String?
  text         String?
}

model ArtsTheme {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  title       String
  slug        String   @unique
  description String
  cover       String

  media       ArtsThemeMediaItem[]
}

model ArtsThemeMediaItem {
  id         String           @id @default(cuid())
  artsThemeId String
  sortOrder  Int              @default(0)

  type       ArtsThemeMediaType
  src        String
  alt        String?
  poster     String?

  artsTheme  ArtsTheme @relation(fields: [artsThemeId], references: [id], onDelete: Cascade)

  @@index([artsThemeId, sortOrder])
}
